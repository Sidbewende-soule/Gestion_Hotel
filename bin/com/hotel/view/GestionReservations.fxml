<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="550.0" prefWidth="650.0" 
      styleClass="root"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.hotel.controller.GestionReservationsController">
   <children>
      <VBox spacing="15.0" style="-fx-padding: 20;">
         <children>
            <Label text="📅 Gestion des Réservations" styleClass="title-label" />
            
            <TableView fx:id="tableReservations" prefHeight="250.0" prefWidth="650.0" styleClass="table-view" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="colClient" prefWidth="120.0" text="CLIENT" />
                <TableColumn fx:id="colChambre" prefWidth="100.0" text="CHAMBRE" />
                <TableColumn fx:id="colDateDebut" prefWidth="100.0" text="DATE DÉBUT" />
                <TableColumn fx:id="colDateFin" prefWidth="100.0" text="DATE FIN" />
                <TableColumn fx:id="colStatut" prefWidth="120.0" text="STATUT" />
              </columns>
            </TableView>
      
            <GridPane fx:id="formulaireModif" hgap="15" vgap="12" styleClass="card-panel">
               <columnConstraints>
                  <ColumnConstraints prefWidth="120.0" />
                  <ColumnConstraints prefWidth="160.0" />
                  <ColumnConstraints prefWidth="250.0" /> 
               </columnConstraints>
               <children>
                  <Label text="Date Début:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                  <TextField fx:id="editDateDebut" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="text-field" />
                  
                  <Label text="Date Fin:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                  <TextField fx:id="editDateFin" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="text-field" />
                  
                  <Label text="Chambre:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="cmbNumeroChambre" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="160.0" styleClass="combo-box" />
                  
                  <Label text="Demandes Spéciales :" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="subtitle-label" />
                  <ListView fx:id="listViewOptions" GridPane.rowIndex="1" GridPane.columnIndex="2" prefHeight="70.0" styleClass="list-view" />
                  
                  <Label text="Notes manuelles :" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="subtitle-label" />
                  <TextArea fx:id="editNotes" GridPane.rowIndex="3" GridPane.columnIndex="2" prefHeight="60.0" styleClass="text-area" />
               </children>
            </GridPane>
      
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="btnModifier" onAction="#modifierReservation" styleClass="button, button-primary" text="Actualiser" />
                  <Button fx:id="btnAnnuler" onAction="#annulerReservation" styleClass="button, button-danger" text="Annuler Réservation" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
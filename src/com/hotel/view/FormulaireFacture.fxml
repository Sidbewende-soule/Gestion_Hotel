<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.controller.FormulaireFactureController"
      stylesheets="@styles.css"
      styleClass="root, card-panel"
      style="-fx-pref-width: 440px;">

    <Label fx:id="lblTitre" text="Nouvelle facture" styleClass="title-label"/>
    <Separator/>

    <GridPane hgap="14" vgap="12">

        <Label text="Réservation *" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboReservation" promptText="Choisir une réservation…"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"
                  styleClass="combo-box"
                  style="-fx-pref-width: 260px;"/>

        <Label text="Date émission *" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dateEmission"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"
                    style="-fx-pref-width: 260px;"/>

        <Label text="Montant total *" GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtMontantTotal" promptText="Ex : 50000"
                   styleClass="text-field"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Statut *" GridPane.rowIndex="3" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="comboStatut"
                  styleClass="combo-box"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"
                  style="-fx-pref-width: 260px;"/>

    </GridPane>

    <Label fx:id="lblErreur" text=""
           styleClass="error-label"
           visible="false" managed="false"/>
    <Separator/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler"
                styleClass="button, button-secondary"/>
        <Button text="Enregistrer" onAction="#enregistrer"
                styleClass="button, button-primary"/>
    </HBox>

</VBox>

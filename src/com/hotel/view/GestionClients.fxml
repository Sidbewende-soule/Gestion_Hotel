<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" styleClass="root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.controller.GestionClientsController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Rechercher:" styleClass="subtitle-label" />
            <TextField fx:id="txtRecherche" promptText="Mot clé (nom, email)..." HBox.hgrow="ALWAYS" styleClass="text-field" />
            <Button mnemonicParsing="false" onAction="#rechercherClient" text="Rechercher" styleClass="button, button-secondary" />
            <Button mnemonicParsing="false" onAction="#reinitialiserRecherche" text="Réinitialiser" styleClass="button, button-secondary" />
            <Button mnemonicParsing="false" onAction="#ouvrirFormulaireAjout" text="Ajouter un client" styleClass="button, button-primary" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tableClients" onMouseClicked="#onClientSelectionne" prefHeight="200.0" prefWidth="200.0" styleClass="table-view" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colNom" prefWidth="120.0" text="Nom" />
          <TableColumn fx:id="colPrenom" prefWidth="120.0" text="Prénom" />
          <TableColumn fx:id="colTelephone" prefWidth="120.0" text="Téléphone" />
          <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
          <TableColumn fx:id="colAdresse" prefWidth="150.0" text="Adresse" />
          <TableColumn fx:id="colCarteFidelite" prefWidth="100.0" text="Fidélité" />
          <TableColumn fx:id="colActions" prefWidth="120.0" text="Actions" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="15.0" top="0.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <right>
      <VBox fx:id="panneauDetail" prefWidth="320.0" spacing="12.0" visible="false" styleClass="card-panel" BorderPane.alignment="CENTER">
         <children>
            <Label text="Détails du Client" styleClass="title-label" />
            <Label fx:id="lblDetailNom" text="👤 Nom Complet" />
            <Label fx:id="lblDetailTel" text="📞 Téléphone" />
            <Label fx:id="lblDetailEmail" text="✉️ Email" />
            <Label fx:id="lblDetailAdresse" text="📍 Adresse" />
            <Label fx:id="lblDetailFidelite" text="🎖️ Carte de fidélité" />
            <Label styleClass="subtitle-label" text="Avis récents :" />
            <ListView fx:id="listAvis" prefHeight="200.0" styleClass="list-view" VBox.vgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirFormulaireAvis" text="Ajouter un avis" styleClass="button, button-primary" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="15.0" right="15.0" top="0.0" />
         </BorderPane.margin>
      </VBox>
   </right>
   <bottom>
      <HBox spacing="20.0" styleClass="status-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblNombreClients" text="0 client(s)" styleClass="subtitle-label" />
            <Label fx:id="lblStatut" text="Prêt pour utilisation." HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
